---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import IconoWhatsApp from '../components/IconoWhatsApp.astro';
import { enlaceWhatsApp } from '../lib/whatsapp.js';
import { site } from '../config/site.js';

// flotante: muestra el botón de WhatsApp fijo en pantalla (se apaga en las fichas, que ya tienen el suyo).
const { titulo, descripcion = site.titular, actual = "", flotante = true, noindex = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${site.nombreCorto}` : `${site.nombre} | ${site.titular}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{tituloCompleto}</title>
  </head>
  <body>
    <Encabezado actual={actual} />
    <main><slot /></main>
    <Pie />
    {flotante && (
      <a class="wa-flotante" href={enlaceWhatsApp('Hola, quisiera hacer una consulta')} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
        <IconoWhatsApp /><span>WhatsApp</span>
      </a>
    )}
  </body>
</html>
